# Copy to .env for LOCAL testing only. Never commit .env, never paste these values into chats.
DEBUG=1
DJANGO_SECRET_KEY=any-long-random-string
# Leave empty locally to use SQLite. On Render use your Neon/Supabase Postgres URL.
DATABASE_URL=

META_APP_SECRET=
PAGE_ACCESS_TOKEN=
VERIFY_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# At least 20 random characters. Used by the HTML admin panel.
ADMIN_API_TOKEN=

SHOP_NAME=My Shop
DELIVERY_CHARGE_DHAKA=80
DELIVERY_CHARGE_OUTSIDE=130

# Local Django admin login (also used on Render to create the admin user)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
